<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  locale={@locale}
  theme={@theme}
  current_path={@conn.request_path}
>
  <div class="mx-auto max-w-2xl py-10 text-center">
    <.header>
      {gettext("Retrospectives your team actually acts on")}
      <:subtitle>
        {gettext(
          "Collect reflections, agree on actions, and see whether they get done — session after session."
        )}
      </:subtitle>
    </.header>

    <div class="mt-8 flex justify-center gap-3">
      <%= if @current_scope && @current_scope.user do %>
        <.link navigate={~p"/home"} class="btn btn-primary">
          {gettext("Go to your teams")}
        </.link>
      <% else %>
        <.link navigate={~p"/users/register"} class="btn btn-primary">
          {gettext("Create an account")}
        </.link>
        <.link navigate={~p"/users/log-in"} class="btn btn-ghost">
          {gettext("Log in")}
        </.link>
      <% end %>
    </div>
  </div>
</Layouts.app>
